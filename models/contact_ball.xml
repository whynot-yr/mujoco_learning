<mujoco model="contact_ball">
    <!--
        v0.2 学习目标：
        1. 理解 geom 之间如何发生接触
        2. 理解 friction 对滑动/滚动的影响
        3. 理解 solref 对反弹/阻尼的影响
    -->

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>
        <light name="top_light" pos="0 0 4"/>

        <!-- 地面 -->
        <geom
            name="floor"
            type="plane"
            size="3 3 0.1"
            rgba="0.8 0.8 0.8 1"

            friction="0.8 0.05 0.01"
            solref="0.01 0.7"
            solimp="0.9 0.95 0.001 0.5 2"
        />

        <!-- 小球 -->
        <body name="ball" pos="-1 0 1.2">
            <freejoint name="ball_free"/>

            <geom
                name="ball_geom"
                type="sphere"
                size="0.1"
                mass="1"
                rgba="1 0 0 1"

                friction="0.8 0.05 0.01"
                solref="0.01 0.7"
                solimp="0.9 0.95 0.001 0.5 2"
            />
        </body>
    </worldbody>
</mujoco>