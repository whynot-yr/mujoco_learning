<mujoco model="motor_pendulum">
    <!--
        v0.4 学习目标：
        1. 理解 actuator 如何把 ctrl 变成关节力矩
        2. 理解 motor 和 joint 的绑定关系
        3. 理解 ctrlrange / gear 的作用
    -->

    <compiler angle="degree"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>
        <light name="top_light" pos="0 0 4"/>

        <geom
            name="floor"
            type="plane"
            size="3 3 0.1"
            rgba="0.85 0.85 0.85 1"
        />

        <body name="support" pos="0 0 1.2">
            <geom
                name="support_vertical"
                type="box"
                pos="0 0 -0.35"
                size="0.04 0.04 0.35"
                rgba="0.2 0.2 0.2 1"
                contype="0"
                conaffinity="0"
            />
            <geom
                name="support_horizontal"
                type="box"
                pos="0 0 0"
                size="0.18 0.04 0.04"
                rgba="0.2 0.2 0.2 1"
                contype="0"
                conaffinity="0"
            />
        </body>

        <body name="pendulum" pos="0 0 1.2">
            <joint
                name="pendulum_hinge"
                type="hinge"
                axis="0 1 0"
                damping="0.12"
                armature="0.02"
                limited="true"
                range="-120 120"
            />

            <geom
                name="rod_geom"
                type="capsule"
                fromto="0 0 0 0 0 -0.6"
                size="0.03"
                mass="0.08"
                rgba="0.1 0.6 0.9 1"
            />

            <body name="bob" pos="0 0 -0.6">
                <geom
                    name="bob_geom"
                    type="sphere"
                    size="0.08"
                    mass="0.12"
                    rgba="0.95 0.35 0.2 1"
                />
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor
            name="pendulum_motor"
            joint="pendulum_hinge"
            gear="1"
            ctrllimited="true"
            ctrlrange="-2 2"
        />
    </actuator>

    <keyframe>
        <key name="tilted_start" qpos="30"/>
    </keyframe>
</mujoco>
