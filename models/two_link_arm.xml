<mujoco model="two_link_arm">
    <!--
        v0.5 学习目标：
        1. 理解 MuJoCo 中 body tree 的层级嵌套
        2. 理解多个 hinge joint 如何组成机械臂
        3. 理解多个 actuator 与多个 ctrl 输入的对应关系
    -->

    <compiler angle="degree"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>

    <worldbody>
        <light name="top_light" pos="0 0 4"/>

        <geom
            name="floor"
            type="plane"
            size="4 4 0.1"
            rgba="0.85 0.85 0.85 1"
        />

        <body name="base" pos="0 0 1.0">
            <geom
                name="base_geom"
                type="box"
                pos="0 0 -0.1"
                size="0.08 0.08 0.1"
                rgba="0.25 0.25 0.25 1"
                contype="0"
                conaffinity="0"
            />

            <body name="link1" pos="0 0 0">
                <joint
                    name="shoulder_joint"
                    type="hinge"
                    axis="0 1 0"
                    damping="0.15"
                    armature="0.02"
                    limited="true"
                    range="-150 150"
                />

                <geom
                    name="link1_geom"
                    type="capsule"
                    fromto="0 0 0 0.6 0 0"
                    size="0.035"
                    mass="0.18"
                    rgba="0.2 0.5 0.9 1"
                />

                <!-- link2 是 link1 的子 body，所以会跟着 link1 一起运动 -->
                <body name="link2" pos="0.6 0 0">
                    <joint
                        name="elbow_joint"
                        type="hinge"
                        axis="0 1 0"
                        damping="0.12"
                        armature="0.02"
                        limited="true"
                        range="-150 150"
                    />

                    <geom
                        name="link2_geom"
                        type="capsule"
                        fromto="0 0 0 0.5 0 0"
                        size="0.03"
                        mass="0.12"
                        rgba="0.9 0.55 0.2 1"
                    />

                    <body name="end_effector" pos="0.5 0 0">
                        <geom
                            name="end_effector_geom"
                            type="sphere"
                            size="0.05"
                            mass="0.03"
                            rgba="0.9 0.2 0.2 1"
                        />
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <actuator>
        <motor
            name="shoulder_motor"
            joint="shoulder_joint"
            gear="3"
            ctrllimited="true"
            ctrlrange="-3 3"
        />
        <motor
            name="elbow_motor"
            joint="elbow_joint"
            gear="3"
            ctrllimited="true"
            ctrlrange="-3 3"
        />
    </actuator>

    <keyframe>
        <key name="start_pose" qpos="20 -30"/>
    </keyframe>
</mujoco>
